# --- Database (used ONLY by the MCP server / database layer, never by the LLM) ---
DATABASE_URL=postgresql://analyst_user:analyst_pass@localhost:5432/ai_analyst

# --- LLM ---
# Uses Gemini's free-tier-friendly API via its OpenAI-compatibility endpoint.
# Get a key at https://aistudio.google.com/apikey
LLM_API_KEY=your-gemini-api-key-here
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_MODEL=gemini-2.5-flash

# To use OpenAI instead, swap to:
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini
# Any other OpenAI-compatible endpoint (Azure OpenAI gateway, local vLLM, etc.) also works.

# --- Agent behavior ---
MAX_RETRIES=3
MAX_ROWS=100

# --- Guardrails ---
REQUIRE_WRITE_CONFIRMATION=true
# Rows affected above this threshold always require confirmation, even if
# REQUIRE_WRITE_CONFIRMATION is false for simple single-row writes.
CONFIRMATION_ROW_THRESHOLD=1

# Comma-separated list of column names that should never be sent back to the LLM
# unless a query explicitly and solely aggregates them (e.g. COUNT(*)).
SENSITIVE_COLUMNS=email,phone,password,ssn,aadhaar,credit_card,salary

# --- MCP server transport ---
# The MCP server in this project runs over stdio and is spawned by the FastAPI
# process's MCP client on startup. No network port is required for MCP itself.
MCP_SERVER_COMMAND=python
MCP_SERVER_ARGS=-m app.mcp.server

# --- Audit log ---
AUDIT_LOG_TABLE=agent_audit_log
