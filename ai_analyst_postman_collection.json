{
  "info": {
    "_postman_id": "a9a3b6f2-bf89-45d2-b7e1-8de3bdf2d71f",
    "name": "AI Analyst Agent API",
    "description": "Collection of test cases for the AI Analyst Agent API running on http://localhost:8000. Includes health checks, schema discovery, read/write queries, PII redaction, and human confirmation flows.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Health & Documentation Check",
